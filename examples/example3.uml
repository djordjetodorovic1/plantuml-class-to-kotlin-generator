@startuml
interface Drawable {
    + draw(): void
}

enum Color {
    RED, GREEN, BLUE, YELLOW
}

abstract class Shape {
    # color: Color
    + abstract calculateArea(): double
}

class Circle {
    + radius: double
    + calculateArea(): double
    + draw(): void
}

class Rectangle {
    + width: double
    + height: double
    + calculateArea(): double
    + draw(): void
}

class Canvas {
    + name: String
    + refresh(): void
}

Circle --|> Shape
Circle ..|> Drawable

Rectangle --|> Shape
Rectangle ..|> Drawable

Canvas "1" o-- "*" Shape : shapes
@enduml