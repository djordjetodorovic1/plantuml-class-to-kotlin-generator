@startuml
enum BookStatus {
    AVAILABLE, BORROWED, RESERVED, LOST
}

interface IBorrowable {
    + borrowItem(memberId: int): boolean
    + returnItem(memberId: int): boolean
}

abstract class Document {
    + id: int
    + title: String
    + abstract getDetails(): String
}

class Book {
    + author: String
    + status: BookStatus
    + getDetails(): String
    + borrowItem(memberId: int): boolean
    + returnItem(memberId: int): boolean
}

class Magazine {
    + issueNumber: int
    + getDetails(): String
}

class LibraryMember {
    + memberId: int
    + fullName: String
}

class Library {
    + name: String
}

Book --|> Document
Book ..|> IBorrowable

Magazine --|> Document

Library "1" o-- "*" Document : catalogue
Library "1" --> "*" LibraryMember : members
@enduml